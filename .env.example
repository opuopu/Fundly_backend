# Application Server
PORT=8081
APP_ENV=development

# Database Settings
DATABASE_URL=postgres://fundly:fundly123@localhost:5435/fundly?sslmode=disable
DB_HOST=localhost
DB_PORT=5435
DB_USER=fundly
DB_PASSWORD=fundly123
DB_NAME=fundly
DB_SSLMODE=disable

# Auto-apply embedded SQL migrations on startup (true/false)
AUTO_MIGRATE=true

# Email / SMTP (OTP + password-reset delivery)
# Leave blank to use the dev log mailer (codes are printed to the server log).
# For Gmail: enable 2-Step Verification, then create an App Password
# (Google Account -> Security -> App passwords) and paste the 16 characters below
# WITHOUT spaces. Use your full Gmail address as SMTP_USERNAME.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=youraddress@gmail.com
SMTP_PASSWORD=your16charapppassword
SMTP_FROM=youraddress@gmail.com
SMTP_FROM_NAME=Fundly
